--==================================================
-- ELIMINAR HITBOX
--==================================================

local function RemoveHitbox(player)

    local Data = Hitboxes[player]

    if not Data then
        return
    end

    if Data.Box then
        pcall(function()
            Data.Box:Destroy()
        end)
    end

    if Data.Highlight then
        pcall(function()
            Data.Highlight:Destroy()
        end)
    end

    Hitboxes[player] = nil
end

--==================================================
-- CREAR / ACTUALIZAR HITBOX
--==================================================

local function ApplyHitbox(player)

    if player == Player then
        return
    end

    if not HitboxEnabled and not InvisibleHitboxEnabled then
        RemoveHitbox(player)
        return
    end

    local Character = player.Character

    if not Character then
        RemoveHitbox(player)
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Humanoid or Humanoid.Health <= 0 then
        RemoveHitbox(player)
        return
    end

    local Data = Hitboxes[player]

    --==================================================
    -- ACTUALIZAR EXISTENTE
    --==================================================

    if Data
        and Data.Box
        and Data.Box.Parent == Character then

        Data.Box.Size = Vector3.new(
            HitboxSize,
            HitboxSize,
            HitboxSize
        )

        if InvisibleHitboxEnabled then

            Data.Box.Transparency = 1

            if Data.Highlight then
                Data.Highlight.Enabled = false
            end

        else

            Data.Box.Transparency = 0.8
            Data.Box.Color = HitboxColor

            if Data.Highlight then

                Data.Highlight.Enabled = true
                Data.Highlight.Adornee = Data.Box
                Data.Highlight.FillColor = HitboxColor
                Data.Highlight.OutlineColor = HitboxColor
                Data.Highlight.FillTransparency = 0.8
                Data.Highlight.OutlineTransparency = 0
                Data.Highlight.DepthMode =
                    Enum.HighlightDepthMode.AlwaysOnTop

            end
        end

        return
    end

    --==================================================
    -- CREAR NUEVA
    --==================================================

    RemoveHitbox(player)

    local Box = Instance.new("Part")

    Box.Name = "IsaitaHitbox"

    Box.Size = Vector3.new(
        HitboxSize,
        HitboxSize,
        HitboxSize
    )

    Box.CFrame = Root.CFrame
    Box.Color = HitboxColor
    Box.Material = Enum.Material.Neon

    Box.CanCollide = false
    Box.CanTouch = false
    Box.CanQuery = true

    Box.Massless = true
    Box.Anchored = false
    Box.CastShadow = false

    if InvisibleHitboxEnabled then
        Box.Transparency = 1
    else
        Box.Transparency = 0.8
    end

    Box.Parent = Character

    --==================================================
    -- WELD
    --==================================================

    local Weld = Instance.new("WeldConstraint")

    Weld.Part0 = Root
    Weld.Part1 = Box
    Weld.Parent = Box

    --==================================================
    -- ESP
    --==================================================

    local Highlight = Instance.new("Highlight")

    Highlight.Name = "IsaitaHitboxESP"
    Highlight.Adornee = Box

    Highlight.FillColor = HitboxColor
    Highlight.OutlineColor = HitboxColor

    Highlight.FillTransparency = 0.8
    Highlight.OutlineTransparency = 0

    Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    Highlight.Enabled =
        not InvisibleHitboxEnabled

    Highlight.Parent = Box

    Hitboxes[player] = {
        Box = Box,
        Highlight = Highlight
    }
end

