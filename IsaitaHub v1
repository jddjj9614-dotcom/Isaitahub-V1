--==================================================
-- JUGADORES
--==================================================

local function SetupPlayer(player)

    if player == Player then
        return
    end

    player.CharacterAdded:Connect(function()

        task.wait(0.5)

        if HitboxEnabled
            or InvisibleHitboxEnabled then

            ApplyHitbox(player)

        end

    end)

    if player.Character then

        task.defer(function()

            if HitboxEnabled
                or InvisibleHitboxEnabled then

                ApplyHitbox(player)

            end

        end)

    end
end

for _, player in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(player)
end

Players.PlayerAdded:Connect(
    SetupPlayer
)

Players.PlayerRemoving:Connect(function(player)

    RemoveHitbox(player)

end)

